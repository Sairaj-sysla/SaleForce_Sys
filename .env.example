# Copy to .env (shared) or .env.<environment> (e.g. .env.dev) — both git-ignored.
# Shell / CI variables always override these files.

# .env  ─────────────────────────────────────────────
# ENVIRONMENT=dev

# .env.dev  ─────────────────────────────────────────
PLAYWRIGHT_USERNAME=
PLAYWRIGHT_PASSWORD=
# BASE_URL=https://yourorg.my.salesforce.com/
# SALESFORCE_EXPECTED_HOST=yourorg.my.salesforce.com

# Gmail OTP (optional filters / tuning)
# GMAIL_OTP_SENDER=noreply@salesforce.com
# GMAIL_OTP_SUBJECT=Verify your identity
# GMAIL_OTP_TIMEOUT_MS=90000
# GMAIL_OTP_POLL_INTERVAL_MS=5000
# GMAIL_OTP_PATTERN=Verification Code:\s*(\d{6})
